# Server Port
PORT=5000

# PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura_health_db

# JWT Secret Key for Session Authentication
JWT_SECRET=aura_super_secure_jwt_secret_key_2026_production

# Frontend Client Origin (for CORS)
CORS_ORIGIN=http://localhost:5173

# Optional: Upload storage directory
UPLOAD_DIR=uploads
